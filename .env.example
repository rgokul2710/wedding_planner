# Copy this file to .env and fill in your Supabase project's values.
# Find these under Supabase Dashboard -> Project Settings -> API.
# The anon key is safe to expose in a static frontend build; Row Level
# Security policies (not this key) are what protect your data.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
